# Copia este archivo a .env y cambia los valores

# Puerto donde queda disponible la app: http://localhost:8085
APP_PORT=8085

# Base de datos
POSTGRES_USER=luci
POSTGRES_PASSWORD=cambia-esta-contraseña
POSTGRES_DB=luci

# Seguridad (genera uno con: openssl rand -hex 32)
JWT_SECRET=cambia-este-secreto

# Usuario administrador inicial (se crea al primer arranque)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contraseña

# Moneda para mostrar precios (código ISO 4217)
CURRENCY=COP

# Cargar productos y materias primas de Informacion.ods si la BD está vacía
SEED_INITIAL_DATA=true

# Tamaño máximo de foto en MB
MAX_UPLOAD_MB=10

# Instalar pytest en la imagen del backend (para correr pruebas)
INSTALL_DEV=true
